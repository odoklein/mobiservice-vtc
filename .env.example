# -----------------------------------------------------------------------------
# MOBISERVICE VTC - Environment Variables Example
# -----------------------------------------------------------------------------
# Copy this file to .env.local (for development) or .env
# Fill in the values for your specific environment.

# --- APP CONFIGURATION ---
# The public URL of the application. Used for links in emails and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Environment mode: development, production, test
NODE_ENV=development

# --- DATABASE (NEON / POSTGRES) ---
# Connection string for your PostgreSQL database.
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_zTh32CfSRuBN@ep-still-resonance-adqs2wzo-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- AUTHENTICATION ---
# Secret key for signing JWT tokens for admin authentication.
# Generate a secure random string (min 32 characters).
JWT_SECRET=123123123

# --- EXTERNAL APIs ---

# 1. DistanceMatrix.ai (Geocoding & Routing)
# Required for address search and automated price calculation.
# Get your key at: https://distancematrix.ai/
DISTANCEMATRIX_API_KEY=your_distancematrix_api_key_here

# 2. Mapbox (Frontend Maps)
# Used for displaying maps and route previews on the reservation page.
# Get your token at: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# 3. Google Maps (Places Autocomplete + Toll Detection)
# Used for precise address search AND automatic toll road detection.
# The same key powers both features - no extra configuration needed.
# Get your key at: https://console.cloud.google.com/
# Required APIs: Places API, Geocoding API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Stripe (Payments)
# Secret key for processing card payments.
# Get your keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Optional: Webhook secret for handling asynchronous payment events.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# --- EMAIL SERVICE (RESEND) ---
# Used for sending OTP codes, booking confirmations, and notifications.
# Get your key at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
# The 'From' email address. Must be a verified domain in Resend.
# Default fallback: onboarding@resend.dev (for testing)
RESEND_FROM_EMAIL=contact@mobiservice-vtc.fr

# --- STORAGE (VERCEL BLOB) ---
# Used for storing generated PDF documents (Devis, Factures).
# Set up in Vercel Dashboard under 'Storage'.
# Token format: prism_...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_02erMxDjATYRSnj0_AFIy0TGC9ERrF65tLYPPIUdoMwmbyB

# --- OPTIONAL / REGIONAL ---
# Default email for the driver to receive new booking notifications.
DRIVER_EMAIL=odosuzali@gmail.com

# Path to Chrome/Chromium executable (optional, for local PDF generation debugging)
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAGUzTtDdiBPRMgA2SrxuRHere5I-vhdck